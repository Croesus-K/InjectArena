# ===== 攻心 InjectArena 服务端配置（BYOK：key 只进服务端内存，绝不发往前端） =====
# 复制本文件为 .env 后填写。所有键都必须以 INJECTARENA_ 开头（.env 白名单约束）。
#
# env 文件查找顺序（谁存在用谁，可用 /api/health 的 envFile 字段确认实际加载了哪个）：
#   1. INJECTARENA_ENV_FILE 环境变量显式指定的路径
#   2. 项目根 .env（即本文件复制出的那份）
#   3. ~/.injectarena/.env（用户级：key 与项目目录解耦，项目文件夹拷走也不带 key）

# OpenAI 兼容服务地址（按你手中的 key 任选其一或自填）：
#   OpenAI    https://api.openai.com/v1
#   DeepSeek  https://api.deepseek.com/v1
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4
#   Kimi      https://api.moonshot.cn/v1
INJECTARENA_BASE_URL=https://api.deepseek.com/v1

# 你的 API key
INJECTARENA_API_KEY=

# 模型名（如 deepseek-chat / glm-4-flash / kimi-k2-0711-preview / gpt-4o-mini）
INJECTARENA_MODEL=deepseek-chat

# 服务监听地址与端口
INJECTARENA_HOST=127.0.0.1
INJECTARENA_PORT=8787

# 每 IP 令牌桶限流（容量=瞬时突发上限；回填=每分钟补充的请求数）
INJECTARENA_CHAT_RATE_CAPACITY=10
INJECTARENA_CHAT_RATE_REFILL=10

# 守方评分限流（一次评测 = 语料条数 × 真实 LLM 调用，成本高，默认更紧）
INJECTARENA_DEFENSE_RATE_CAPACITY=2
INJECTARENA_DEFENSE_RATE_REFILL=2

# 评测并发（同时打向 LLM 的 payload 数；免费池建议 1-4）
INJECTARENA_EVAL_CONCURRENCY=4

# 审计日志 SQLite 文件路径
INJECTARENA_DB_PATH=data/audit.db
