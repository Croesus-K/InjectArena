{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InjectArena 关卡定义（一座阵）",
  "type": "object",
  "required": ["id", "name", "attackSurface", "difficulty", "brief", "defenseBrief", "systemPrompt", "secret", "flagCriteria", "guard"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^L[1-9]$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 12 },
    "attackSurface": {
      "type": "string",
      "enum": ["direct-injection", "data-exfiltration", "guarded-prompt", "indirect-injection", "tool-abuse"]
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "brief": { "type": "string", "minLength": 8, "maxLength": 500 },
    "defenseBrief": { "type": "string", "minLength": 8, "maxLength": 500 },
    "hints": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 4, "maxLength": 200 }
    },
    "systemPrompt": { "type": "string", "minLength": 20, "maxLength": 4000 },
    "model": { "type": "string", "minLength": 3, "maxLength": 120 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "description", "parameters"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
          "description": { "type": "string", "minLength": 4, "maxLength": 300 },
          "parameters": { "type": "object" }
        }
      }
    },
    "knowledgeBase": {
      "type": "object",
      "required": ["documents"],
      "additionalProperties": false,
      "properties": {
        "topK": { "type": "integer", "minimum": 1, "maximum": 5 },
        "documents": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "title", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^kb-[0-9]{1,3}$" },
              "title": { "type": "string", "minLength": 2, "maxLength": 60 },
              "text": { "type": "string", "minLength": 10, "maxLength": 1200 }
            }
          }
        }
      }
    },
    "secret": { "type": "string", "pattern": "^FLAG\\{[^}]{6,64}\\}$" },
    "flagCriteria": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "containsSecret" } }
        },
        {
          "type": "object",
          "required": ["kind", "values"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "containsAny" },
            "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } }
          }
        }
      ]
    },
    "guard": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "patterns", "message"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "keywordBlock" },
            "patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "message": { "type": "string", "minLength": 2, "maxLength": 500 }
          }
        }
      ]
    }
  }
}
