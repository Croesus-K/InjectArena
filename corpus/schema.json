{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InjectArena 攻击 payload 语料库",
  "type": "object",
  "required": ["id", "attackSurface", "description", "payloads"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "attackSurface": {
      "type": "string",
      "enum": ["direct-injection", "data-exfiltration", "guarded-prompt", "indirect-injection", "tool-abuse", "mcp-poisoning"]
    },
    "description": { "type": "string", "minLength": 8, "maxLength": 300 },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "lang", "mode", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]{2,8}-[0-9]{3}$" },
          "lang": { "enum": ["zh", "en", "mix"] },
          "mode": {
            "enum": [
              "direct-ask",
              "instruction-override",
              "roleplay",
              "authority-forgery",
              "encoding",
              "translation",
              "hypothetical",
              "context-switch",
              "completion",
              "json-exfil",
              "emotional",
              "other"
            ]
          },
          "text": { "type": "string", "minLength": 4, "maxLength": 600 },
          "kind": {
            "type": "string",
            "enum": ["attack", "benign"],
            "default": "attack",
            "description": "载荷性质：attack=试图夺旗；benign=正常业务请求，用于测算误杀率。不填按 attack 算（向后兼容）。"
          }
        }
      }
    }
  }
}
